{
    "name": "udec/ingenieria-economica-backend",
    "description": "Backend PHP de la app de Ingeniería Económica (Slim 4 + BCMath)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-json": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8080 -t public"
    }
}

# Variables de entorno para SafeMoneyApp
# Copia este archivo a .env y ajusta los valores según sea necesario

# Entorno de aplicación
APP_ENV=development
APP_DEBUG=false

# CORS - Dominio permitido (usa * en desarrollo, especifica el dominio en producción)
ALLOWED_ORIGIN=*

# Base de datos (actualmente no se usa, pero preparado para expansiones futuras)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=safe_money_app
DB_USER=root
DB_PASSWORD=

# Versión de PHP (detectada automáticamente, pero puede sobrescribirse)
PHP_VERSION=8.2
